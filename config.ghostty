# ~/.config/ghostty/config

# ─── FONT ────────────────────────────────────────────────
font-family = "0xProto Nerd Font"
font-family-bold = "0xProto Nerd Font"
font-family-italic = "0xProto Nerd Font"
font-size = 14
font-thicken = true
# tự tổng hợp bold-italic nếu font thiếu
font-synthetic-style = bold-italic
font-feature = -calt
adjust-cell-height = 3
adjust-cursor-thickness = 2

# ─── THEME & MÀU SẮC ─────────────────────────────────────
# tự đổi theo light/dark mode hệ thống
theme = light:Catppuccin Latte,dark:Catppuccin Frappe
alpha-blending = linear-corrected

# ─── CURSOR ──────────────────────────────────────────────
cursor-style = block
cursor-style-blink = false
# màu cursor theo chữ ô, màu chữ trong cursor theo nền ô
cursor-color = cell-foreground
cursor-text = cell-background

# ─── CỬA SỔ ──────────────────────────────────────────────
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true
window-save-state = always
# auto | none | client | server
window-decoration = auto
background-opacity = 0.95
background-blur-radius = 20

# thư mục làm việc mặc định
working-directory = home
# tab/split mới kế thừa thư mục hiện tại
window-inherit-working-directory = true
quit-after-last-window-closed = true

# ─── SHELL ───────────────────────────────────────────────
shell-integration = detect
shell-integration-features = sudo,title

# ─── MISC ────────────────────────────────────────────────
mouse-hide-while-typing = true
mouse-scroll-multiplier = 3
scrollback-limit = 10000
clipboard-read = allow
clipboard-write = allow

# ─── KEYBINDS: TABS ──────────────────────────────────────
keybind = ctrl+t=new_tab
keybind = ctrl+w=close_surface
keybind = ctrl+shift+w=close_tab
keybind = ctrl+shift+l=next_tab
keybind = ctrl+shift+h=previous_tab
keybind = ctrl+1=goto_tab:1
keybind = ctrl+2=goto_tab:2
keybind = ctrl+3=goto_tab:3
keybind = ctrl+4=goto_tab:4

# ─── KEYBINDS: SPLITS ────────────────────────────────────
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+e=new_split:down
keybind = alt+h=goto_split:left
keybind = alt+l=goto_split:right
keybind = alt+k=goto_split:up
keybind = alt+j=goto_split:down

# ─── KEYBINDS: FONT SIZE ─────────────────────────────────
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+0=reset_font_size

# ─── KEYBINDS: RELOAD ────────────────────────────────────
keybind = ctrl+shift+comma=reload_config
